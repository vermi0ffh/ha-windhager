          "0": "Burner blocked",
          "1": "Self-test",
          "2": "Turn off heat generator",
          "3": "Standby",
          "4": "Burner OFF",
          "5": "Pre-purge",
          "6": "Ignition phase",
          "7": "Flame stabilization",
          "8": "Modulating mode",
